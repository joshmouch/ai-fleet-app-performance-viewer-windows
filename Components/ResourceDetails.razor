@using Microsoft.AspNetCore.Components
@using Microsoft.AspNetCore.Components.Web

<section class="resource-details" aria-label="@($"{Node.Name} details")" @onclick:stopPropagation="true">
    <div class="resource-details-tabs">
        <div class="resource-detail-controls">
            <button type="button" aria-pressed="@(view == ResourceDetailView.Processes ? "true" : "false")"
                @onclick="() => Show(ResourceDetailView.Processes)">Processes</button>
            @if (Disk)
            {
                <button type="button" aria-pressed="@(view == ResourceDetailView.Paths ? "true" : "false")"
                    @onclick="() => Show(ResourceDetailView.Paths)">Paths</button>
                <button type="button" aria-pressed="@(view == ResourceDetailView.Folders ? "true" : "false")"
                    @onclick="() => Show(ResourceDetailView.Folders)">Folders</button>
            }
        </div>
        <div class="resource-detail-facts">
            @if (BandPercent > 0 && data?.SortMetric is { } sort && Data.Rows.Length > 0)
            {
                <span class="resource-band-coverage"
                    title="Bands use the sorted column's total before the Top rows limit. Expanded folder contents are included in their parent total.">
                    @if (Data.BandIssue is string issue) { @issue }
                    else
                    {
                        var basis = sort.BandBasis ?? sort.Label;
                        @if (Data.TotalWeight > 0)
                        {
                            <text>Bands by @basis · @sort.Display(Data.TotalWeight) total · @ResourceDetailTable.FormatShare(Data.ShownShare) shown · @ResourceDetailTable.FormatShare(1 - Data.ShownShare) outside list</text>
                        }
                        else { <text>No @basis values for bands</text> }
                    }
                </span>
            }
            @if (data?.Summary is string summary)
            {
                <span class="resource-details-summary" title="@(Disk ? "Totals for all matching rows in this scope" : "Guest CPU attribution coverage for this scope")">@summary</span>
            }
        </div>
        @if (Close.HasDelegate)
        {
            <button class="resource-icon close-details" type="button" aria-label="Close details pane"
                title="Close details pane" @onclick="Close">×</button>
        }
    </div>
    @if (Loading)
    {
        <MeasurementNotice Title="@($"Loading {view.ToString().ToLowerInvariant()}")" Loading="true" />
    }
    else if (Data.Note is string note)
    {
        <div class="details-notice" role="status">@note</div>
    }
    @if (!Loading && Data.Rows.Length > 0)
    {
        var labels = Data.LabelColumns;
        if (view == ResourceDetailView.Folders) labels = ["Process", "File / folder", "Folder", "PID", "Environment"];
        <div class="scroll" tabindex="0" role="region" aria-label="@(Paths ? "Path rankings" : "Process rankings")">
            <table class="@(Paths ? "resource-path-rankings" : null)">
                <thead><tr>
                    @foreach (string column in labels) { <th scope="col" data-copy-label="@column">@column</th> }
                    @foreach (var metric in Data.Metrics)
                    {
                        bool sorted = Data.SortedBy == metric.Key;
                        <th scope="col" class="num" data-copy-label="@metric.Label"
                            aria-sort="@(sorted ? "descending" : null)" title="@metric.Hint">
                            @if (metric.Sortable)
                            {
                                <button type="button" class="detail-sort" @onclick="() => SortChanged.InvokeAsync(metric.Key)">
                                    @metric.Label @if (sorted) { <span aria-hidden="true">▼</span> }
                                </button>
                            }
                            else { @metric.Label }
                        </th>
                    }
                </tr></thead>
                <tbody><ResourceDetailRows Data="Data" BandPercent="BandPercent" Expanded="expanded"
                    Branches="branches" Toggle="ToggleFolder" Scope="OpenFolder" /></tbody>
            </table>
        </div>
    }
    else if (!Loading && Data.Note == null) { <div class="details-notice" role="status">No matching measurements</div> }
</section>

@code {
    [Parameter, EditorRequired] public ResourceNode Node { get; set; } = default!;
    [Parameter, EditorRequired] public Func<ResourceNode, ResourceDetailView, DiskPathFolder?, Task<ResourceDetailTable>> Read { get; set; } = default!;
    [Parameter] public bool Disk { get; set; }
    [Parameter] public int BandPercent { get; set; }
    [Parameter] public EventCallback Close { get; set; }
    [Parameter] public EventCallback<string> SortChanged { get; set; }
    [Parameter] public EventCallback<(ResourceNode Node, DiskPathFolder Folder)> FolderSelected { get; set; }
    private ResourceDetailView view;
    private bool Paths => view != ResourceDetailView.Processes;
    private readonly Dictionary<string, DiskPathFolder> expanded = new();
    private IReadOnlyDictionary<string, ResourceDetailTable> branches = new Dictionary<string, ResourceDetailTable>();
    private ResourceDetailTable? data;
    private ResourceDetailTable Data => data!;
    private bool Loading => data == null;
    private int request;
    protected override void OnInitialized() => view = Node.Kind == ResourceKind.Folder ? ResourceDetailView.Folders :
        Disk ? ResourceDetailView.Paths : ResourceDetailView.Processes;
    protected override Task OnParametersSetAsync() => Refresh();
    private Task Show(ResourceDetailView next)
    {
        if (view == next) return Task.CompletedTask;
        view = next;
        expanded.Clear();
        data = null;
        return Refresh();
    }
    private Task ToggleFolder(DiskPathFolder folder)
    {
        if (!expanded.TryAdd(folder.Id, folder))
            foreach (var key in expanded.Keys.Where(key => key.StartsWith(folder.Id, StringComparison.Ordinal)).ToArray())
                expanded.Remove(key);
        return Refresh();
    }
    private Task OpenFolder(DiskPathFolder folder) => FolderSelected.InvokeAsync((Node, folder));
    private async Task Refresh()
    {
        int version = ++request;
        var next = Read(Node, view, null);
        var open = await Task.WhenAll(expanded.Values.Select(async folder => (folder.Id, Table: await Read(Node, view, folder))));
        var table = await next;
        if (version != request) return;
        branches = open.ToDictionary(x => x.Id, x => x.Table);
        data = table;
    }
}
