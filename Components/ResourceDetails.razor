@using Microsoft.AspNetCore.Components
@using Microsoft.AspNetCore.Components.Web

<section class="resource-details" aria-label="@($"{Node.Name} details")" @onclick:stopPropagation="true">
    <div class="resource-details-tabs">
        @if (Close.HasDelegate) { <h3 class="resource-detail-heading">@Node.Name details</h3> }
        <button type="button" aria-pressed="@(!Paths ? "true" : "false")" @onclick="() => Show(false)">Processes</button>
        @if (Disk) { <button type="button" aria-pressed="@(Paths ? "true" : "false")" @onclick="() => Show(true)">Paths</button> }
        @if (data?.Summary is string summary)
        {
            <span class="resource-details-summary" title="@(Disk ? "Totals for all matching rows in this scope" : "Guest CPU attribution coverage for this scope")">@summary</span>
        }
        @if (Close.HasDelegate)
        {
            <button class="resource-icon close-details" type="button" aria-label="Close details pane"
                title="Close details pane" @onclick="Close">×</button>
        }
    </div>
    @if (Loading)
    {
        <MeasurementNotice Title="@(Paths ? "Loading paths" : "Loading processes")" Loading="true" />
    }
    else if (Data.Note is string note)
    {
        <div class="details-notice" role="status">@note</div>
    }
    @if (!Loading && Data.Rows.Length > 0)
    {
        var labels = Data.LabelColumns;
        <div class="scroll" tabindex="0" role="region" aria-label="@(Paths ? "Path rankings" : "Process rankings")">
            <table class="@(Paths ? "resource-path-rankings" : null)">
                <thead><tr>
                    @foreach (string column in labels) { <th scope="col" data-copy-label="@column">@column</th> }
                    @foreach (var metric in Data.Metrics)
                    {
                        bool sorted = Data.SortedBy == metric.Key;
                        <th scope="col" class="num" data-copy-label="@metric.Label"
                            aria-sort="@(sorted ? "descending" : null)" title="@metric.Hint">
                            @if (metric.Sortable)
                            {
                                <button type="button" class="detail-sort" @onclick="() => SortChanged.InvokeAsync(metric.Key)">
                                    @metric.Label @if (sorted) { <span aria-hidden="true">▼</span> }
                                </button>
                            }
                            else { @metric.Label }
                        </th>
                    }
                </tr></thead>
                <tbody>
                @foreach (var group in Bands)
                {
                    @if (group.Label != null)
                    {
                        <tr class="resource-band" title="Rows grouped by where their cumulative share starts. Subtotals cover the displayed rows.">
                            <th colspan="@(Paths ? 2 : labels.Length)" scope="row">@group.Label</th>
                            @if (Paths) { <td colspan="@(labels.Length - 2)" aria-hidden="true"></td> }
                            @for (int column = 0; column < Data.Metrics.Length; column++)
                            { <td class="num">@Data.Metrics[column].Display(Data.Metrics[column].Subtotal(group.Rows, column))</td> }
                        </tr>
                    }
                    @foreach (var row in group.Rows)
                    {
                        var fullPath = Paths && row.Labels[2].Length > 0 ? row.Labels[2] + row.Labels[1] : null;
                        <tr data-copy-row="" tabindex="@(fullPath == null ? "0" : null)">
                            @for (int index = 0; index < row.Labels.Length; index++)
                            {
                                var label = row.Labels[index];
                                <td class="resource-cell" title="@label">
                                    @if (index == 1 && fullPath != null)
                                    {
                                        <button type="button" class="file-path-button" data-full-path="@fullPath"
                                            aria-label="@($"Show full path for {label}")" aria-haspopup="dialog">@label</button>
                                    }
                                    else { @label }
                                </td>
                            }
                            @for (int column = 0; column < Data.Metrics.Length; column++)
                            { <td class="num">@Data.Metrics[column].Display(row.Values[column])</td> }
                        </tr>
                    }
                }
                </tbody>
            </table>
        </div>
    }
    else if (!Loading && Data.Note == null) { <div class="details-notice" role="status">No matching measurements</div> }
</section>

@code {
    [Parameter, EditorRequired] public ResourceNode Node { get; set; } = default!;
    [Parameter, EditorRequired] public Func<ResourceNode, bool, Task<ResourceDetailTable>> Read { get; set; } = default!;
    [Parameter] public bool Disk { get; set; }
    [Parameter] public int BandPercent { get; set; }
    [Parameter] public EventCallback Close { get; set; }
    [Parameter] public EventCallback<string> SortChanged { get; set; }
    private bool Paths;
    private ResourceDetailTable? data;
    private ResourceDetailTable Data => data!;
    private bool Loading => data == null;
    private int request;
    protected override Task OnParametersSetAsync() => Refresh();
    private Task Show(bool paths)
    {
        if (Paths == paths) return Task.CompletedTask;
        Paths = paths;
        data = null;
        return Refresh();
    }
    private async Task Refresh()
    {
        int version = ++request;
        var next = await Read(Node, Paths);
        if (version == request) data = next;
    }
    private sealed record Band(string? Label, ResourceDetailRow[] Rows);
    private IEnumerable<Band> Bands
    {
        get
        {
            var data = Data;
            if (BandPercent <= 0 || data.TotalWeight <= 0) return [new(null, data.Rows)];
            double consumed = 0;
            int Bucket(ResourceDetailRow row)
            {
                int start = Math.Min(99, (int)(consumed / data.TotalWeight * 100)) / BandPercent * BandPercent;
                consumed += row.Weight;
                return start;
            }
            return data.Rows.GroupBy(Bucket).Select(g =>
                new Band($"Starts in {g.Key}–{Math.Min(100, g.Key + BandPercent)}%", g.ToArray())).ToArray();
        }
    }
}
