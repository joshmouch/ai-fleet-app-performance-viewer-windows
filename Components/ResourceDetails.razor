@using Microsoft.AspNetCore.Components
@using Microsoft.AspNetCore.Components.Web

<section class="resource-details" aria-label="@($"{Node.Name} details")" @onclick:stopPropagation="true">
    <div class="resource-details-tabs">
        @if (Close.HasDelegate) { <h3 class="resource-detail-heading">@Node.Name details</h3> }
        <button type="button" aria-pressed="@(!Paths ? "true" : "false")" @onclick="() => Show(false)">Processes</button>
        <button type="button" aria-pressed="@(Paths ? "true" : "false")" @onclick="() => Show(true)">@(Disk ? "Paths" : "Commands")</button>
        @if (Data.Summary is string summary)
        {
            <span class="resource-details-summary" title="Totals for all matching rows in this scope">@summary</span>
        }
        @if (Close.HasDelegate)
        {
            <button class="resource-icon close-details" type="button" aria-label="Close details pane"
                title="Close details pane" @onclick="Close">×</button>
        }
    </div>
    @if (Data.Note is string note)
    {
        <div class="details-notice" role="status">@note</div>
    }
    @if (Data.Rows.Length > 0)
    {
        <div class="scroll">
            <table>
                <thead><tr>@foreach (string column in Data.Columns) { <th scope="col">@column</th> }</tr></thead>
                <tbody>
                @foreach (var group in Bands)
                {
                    @if (group.Label != null)
                    {
                        <tr class="resource-band" title="Rows grouped by where their cumulative share starts. Subtotals cover the displayed rows.">
                            <th colspan="@group.FirstNumber" scope="rowgroup">@group.Label</th>
                            @for (int column = group.FirstNumber; column < Data.Columns.Length; column++)
                            { <td class="num">@Subtotal(group.Rows, column)</td> }
                        </tr>
                    }
                    @foreach (var row in group.Rows)
                    {
                        <tr>
                            @for (int column = 0; column < row.Values.Length; column++)
                            {
                                var value = row.Values[column];
                                <td class="@(column >= FirstNumber ? "num" : "resource-cell")" title="@value">@value</td>
                            }
                        </tr>
                    }
                }
                </tbody>
            </table>
        </div>
    }
    else if (Data.Note == null) { <div class="details-notice" role="status">No matching measurements</div> }
</section>

@code {
    [Parameter, EditorRequired] public ResourceNode Node { get; set; } = default!;
    [Parameter, EditorRequired] public Func<ResourceNode, bool, ResourceDetailTable> Read { get; set; } = default!;
    [Parameter] public bool Disk { get; set; }
    [Parameter] public int BandPercent { get; set; }
    [Parameter] public EventCallback Close { get; set; }
    private bool Paths;
    private ResourceDetailTable Data = new([], []);
    private int FirstNumber => Data.Columns.Length - (Disk ? 7 : 2);
    protected override void OnParametersSet() => Data = Read(Node, Paths);
    private void Show(bool paths)
    {
        Paths = paths;
        Data = Read(Node, Paths);
    }
    private sealed record Band(string? Label, ResourceDetailRow[] Rows, int FirstNumber = 0);
    private IEnumerable<Band> Bands
    {
        get
        {
            var data = Data;
            if (BandPercent <= 0 || data.TotalWeight <= 0) return [new(null, data.Rows)];
            double consumed = 0;
            int Bucket(ResourceDetailRow row)
            {
                int start = Math.Min(99, (int)(consumed / data.TotalWeight * 100)) / BandPercent * BandPercent;
                consumed += row.Weight;
                return start;
            }
            return data.Rows.GroupBy(Bucket).Select(g =>
                new Band($"Starts in {g.Key}–{Math.Min(100, g.Key + BandPercent)}%", g.ToArray(), FirstNumber)).ToArray();
        }
    }
    private string Subtotal(ResourceDetailRow[] rows, int column)
    {
        var values = rows.Select(row => row.Numbers[column]).OfType<double>().ToArray();
        if (values.Length == 0) return "—";
        var format = Data.Columns[column] is "Reads" or "Writes" or "Total ops" ? "N0" : "N2";
        return values.Sum().ToString(format) + (Disk ? "" : "%");
    }
}
