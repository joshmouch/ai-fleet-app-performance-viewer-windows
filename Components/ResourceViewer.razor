@using Microsoft.AspNetCore.Components
@using Microsoft.AspNetCore.Components.Web
@using Microsoft.JSInterop
@using System.Text.Json
@inject IJSRuntime Browser

<main class="viewer">
    <h1 class="visually-hidden">AI Fleet Cluster Performance Viewer</h1>
    @if (!ready)
    {
        <MeasurementNotice Title="Opening viewer" Loading="true" />
    }
    else
    {
        <div class="viewer-controls">
            <div class="toolbar quick-settings">
                <div class="switch" role="group" aria-label="Show resources">
                    <button type="button" aria-pressed="@Pressed(preferences.ShowCpu)" @onclick="ToggleCpu">CPU</button>
                    <button type="button" aria-pressed="@Pressed(preferences.ShowDisk)" @onclick="ToggleDisk">Disk</button>
                </div>
                @if (preferences.ShowDisk && !archive.Active)
                {
                    <button type="button" aria-expanded="@Pressed(diskLayoutOpen)" aria-controls="disk-layout"
                        @onclick="ToggleDiskLayout">Arrange Disk cards @(diskLayoutOpen ? "▴" : "▾")</button>
                }
                <input type="search" aria-label="Filter resources, processes and paths" placeholder="Filter resources, processes, paths"
                    @bind="filter" @bind:event="oninput" />
                @if (Sources.Length > 0 && !archive.Active)
                {
                    <details class="source-info">
                        <summary title="Collection status">@(Sources.Length == 1 ? Status(Sources[0]) : $"{Sources.Count(s => s.Selected)}/{Sources.Length} sources ready")</summary>
                        <ul class="sources" aria-label="Collection status">
                            @foreach (var source in Sources)
                            { <li><strong>@source.Name</strong> <span>@Status(source)</span></li> }
                        </ul>
                    </details>
                }
                <button type="button" aria-expanded="@Pressed(settings)" @onclick="ToggleSettings">Settings @(settings ? "▴" : "▾")</button>
            </div>
            @if (preferences.ShowDisk && !archive.Active)
            {
                <div class="disk-layout" id="disk-layout" hidden="@(!diskLayoutOpen)">
                    <fieldset disabled="@preferences.DiskLayout.VirtualDisksOnly">
                        <legend>Start with</legend>
                        <label><input type="radio" name="disk-hierarchy" checked="@ByVolumes"
                            @onchange="() => ChangeDiskLayout(preferences.DiskLayout with { Hierarchy = DiskHierarchy.Volumes })" /> Volumes and mounts</label>
                        <label><input type="radio" name="disk-hierarchy" checked="@(!ByVolumes)"
                            @onchange="() => ChangeDiskLayout(preferences.DiskLayout with { Hierarchy = DiskHierarchy.Environments })" /> Windows and guests</label>
                    </fieldset>
                    <fieldset disabled="@(!ByVolumes || preferences.DiskLayout.VirtualDisksOnly)">
                        <legend>Inside volumes</legend>
                        <label><input type="checkbox" checked="@preferences.DiskLayout.BusyFolders"
                            @onchange="e => ChangeDiskLayout(preferences.DiskLayout with { BusyFolders = (bool)e.Value! })" /> Busy folders</label>
                        <label><input type="checkbox" checked="@preferences.DiskLayout.GuestDisks"
                            @onchange="e => ChangeDiskLayout(preferences.DiskLayout with { GuestDisks = (bool)e.Value! })" /> VM and WSL disks</label>
                    </fieldset>
                    <fieldset>
                        <legend>Show cards for</legend>
                        <label><input type="radio" name="disk-card-filter" checked="@(!preferences.DiskLayout.VirtualDisksOnly)"
                            @onchange="() => ChangeDiskLayout(preferences.DiskLayout with { VirtualDisksOnly = false })" /> All activity</label>
                        <label><input type="radio" name="disk-card-filter" checked="@preferences.DiskLayout.VirtualDisksOnly"
                            @onchange="() => ChangeDiskLayout(preferences.DiskLayout with { VirtualDisksOnly = true })" /> Virtual disk files only</label>
                    </fieldset>
                    <p class="disk-layout-preview" aria-live="polite">@DiskLayoutPreview</p>
                </div>
            }
            @if (settingsOpened)
            {
                <div class="toolbar advanced-settings" hidden="@(!settings)">
                    <label>Host <select @bind="preferences.Host" @bind:after="ChangeHost">
                        <option value="">All hosts</option>
                        @foreach (var name in HostNames) { <option value="@name">@name</option> }
                    </select></label>
                    <label>Guest details <input type="checkbox" @bind="preferences.Guests" @bind:after="Save" /></label>
                    @if (preferences.Guests)
                    {
                        @foreach (var target in GuestTargets)
                        {
                            <label><input type="checkbox" checked="@preferences.IncludesGuest(target.Host, target.Target)"
                                @onchange="e => SetGuest(target, (bool)e.Value!)" /> @target.Target</label>
                        }
                    }
                    @if (preferences.ShowCpu)
                    {
                        <label><input type="checkbox" @bind="preferences.ShowLogicalProcessors" @bind:after="Save" /> Logical processors</label>
                        <label>Min CPU % <input type="number" min="0" max="100" @bind="preferences.MinCpuActivity" @bind:after="Save" /></label>
                    }
                    @if (preferences.ShowDisk)
                    {
                        <label>Min active % <input type="number" min="0" max="100" @bind="preferences.MinDiskActivity" @bind:after="Save" /></label>
                        <label>Min I/O MiB/s <input type="number" min="0" step="0.1" @bind="preferences.MinRate" @bind:after="Save" /></label>
                        @if (ByVolumes && preferences.DiskLayout.BusyFolders)
                        {
                            <label title="Minimum share of this host’s captured reads and writes for a folder card">
                                Min folder host I/O % <input type="number" min="0" max="100" step="0.1" @bind="preferences.MinFolderPercent" @bind:after="Save" />
                            </label>
                        }
                        <label>All disks <input type="checkbox" @bind="preferences.AllDisks" @bind:after="Save" /></label>
                    }
                    <label>Max cards per level <input type="number" min="1" max="100" @bind="preferences.MaxCards" @bind:after="Save" /></label>
                    <label>Top rows <input type="number" min="1" max="100" @bind="preferences.MaxRows" @bind:after="Save" /></label>
                    <label>Usage band % <input type="number" min="1" max="100" @bind="preferences.Band" @bind:after="Save" /></label>
                    @if (preferences.ShowDisk || archive.Active)
                    {
                        <div hidden="@(!preferences.ShowDisk)"><HistoryPicker Changed="value => archive = value" /></div>
                    }
                    @if (preferences.ShowCpu || preferences.ShowDisk)
                    {
                        <button type="button" aria-expanded="@Pressed(timelines)" @onclick="() => timelines = !timelines">Stored timelines</button>
                    }
                    @if (settings && timelines)
                    {
                        @if (preferences.ShowCpu) { <ResourceHistory Disk="false" /> }
                        @if (preferences.ShowDisk) { <ResourceHistory Disk="true" /> }
                    }
                    @if (preferenceError != null) { <span role="status">@preferenceError</span> }
                </div>
            }
        </div>
        @if (!preferences.ShowCpu && !preferences.ShowDisk)
        {
            <MeasurementNotice Title="Turn on CPU or Disk to view activity" />
        }
        <div class="viewer-sections @(Combined ? "viewer-combined" : "")">
            <ResourceSection Sources="Sources" Preferences="preferences" Visible="preferences.ShowCpu" Combined="Combined" Filter="@filter"
                SavePreferences="Save" SharedScope="sharedScope" SharedScopeChanged="ChangeScope" />
            <ResourceSection Sources="Sources" Preferences="preferences" Visible="preferences.ShowDisk" Combined="Combined" Filter="@filter"
                Disk="true" Archive="archive" SavePreferences="Save" SharedScope="sharedScope" SharedScopeChanged="ChangeScope" />
        </div>
    }
</main>

@code {
    [Parameter] public SourceWindow[] Sources { get; set; } = [];
    private const string PreferenceKey = "ai-fleet-performance-viewer.preferences.v1";
    private ViewerPreferences preferences = new();
    private bool ready, settings, settingsOpened, timelines, diskLayoutOpen;
    private string? preferenceError;
    private string filter = "";
    private ResourceScope sharedScope = new();
    private HistorySelection archive = new(false, null);
    private bool Combined => preferences.ShowCpu && preferences.ShowDisk;
    private bool ByVolumes => preferences.DiskLayout.Hierarchy == DiskHierarchy.Volumes;
    private string DiskLayoutPreview => preferences.DiskLayout switch
    {
        { VirtualDisksOnly: true } => "Current scope → Virtual disk file → Guest device",
        { Hierarchy: DiskHierarchy.Environments } => "Windows files   |   Unattributed I/O   |   Guest → Virtual disk file → Guest device",
        { BusyFolders: true, GuestDisks: true } => "Volume → Folder → Subfolder   |   Volume → VM or WSL → Virtual disk file → Guest device",
        { BusyFolders: true } => "Volume → Folder → Subfolder",
        { GuestDisks: true } => "Volume → VM or WSL → Virtual disk file → Guest device",
        _ => "Volumes and mounts"
    };
    private IEnumerable<string> HostNames => Sources.Select(source => source.Frame?.Host ?? source.GuestOf)
        .Append(preferences.Host).OfType<string>().Where(name => name.Length != 0).Distinct(StringComparer.OrdinalIgnoreCase).Order();
    private IEnumerable<ViewerPreferences.Guest> GuestTargets => Sources.Where(source => source.Selected).SelectMany(source =>
        source.Frame is { } frame
            ? (frame.Guests?.Cpu?.Sample.Coverage.Select(row => row.Machine) ?? [])
                .Concat(frame.Guests?.Disks.Select(row => row.Target) ?? []).Select(target => new ViewerPreferences.Guest(frame.Host, target))
            : source.GuestOf is { } host ? [new(host, source.Name)] : [])
        .Where(guest => preferences.Host.Length == 0 || string.Equals(guest.Host, preferences.Host, StringComparison.OrdinalIgnoreCase))
        .Distinct();

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender) return;
        try
        {
            var json = await Browser.InvokeAsync<string?>("localStorage.getItem", PreferenceKey);
            if (json != null && ViewerPreferences.Load(json) is { } saved) preferences = saved;
        }
        catch (JSDisconnectedException) { return; }
        catch (Exception e) when (e is JSException or JsonException) { preferenceError = "Saved settings could not be loaded."; }
        ready = true;
        StateHasChanged();
    }

    private async Task Save()
    {
        try
        {
            await Browser.InvokeVoidAsync("localStorage.setItem", PreferenceKey, JsonSerializer.Serialize(preferences));
            preferenceError = null;
        }
        catch (JSDisconnectedException) { }
        catch (JSException) { preferenceError = "Settings could not be saved."; }
    }

    private Task ToggleCpu() { preferences.ShowCpu = !preferences.ShowCpu; return Save(); }
    private Task ToggleDisk() { preferences.ShowDisk = !preferences.ShowDisk; return Save(); }
    private void ChangeScope(ResourceScope scope) => sharedScope = scope;
    private Task ChangeHost() { sharedScope = new(); return Save(); }
    private void ToggleSettings() { settings = !settings; settingsOpened = true; diskLayoutOpen = false; }
    private void ToggleDiskLayout() { diskLayoutOpen = !diskLayoutOpen; settings = false; }
    private Task ChangeDiskLayout(DiskCardLayout layout) { preferences.DiskLayout = layout; return Save(); }
    private Task SetGuest(ViewerPreferences.Guest target, bool enabled)
    {
        if (enabled) preferences.HiddenGuests.Remove(target); else preferences.HiddenGuests.Add(target);
        return Save();
    }
    private static string Pressed(bool value) => value ? "true" : "false";
    private static string Status(SourceWindow source)
    {
        var frame = source.Frame;
        if (frame == null && source.GuestDisk == null) return source.Status ?? "Waiting";
        var mode = source.Stale ? "Stale" : source.Replay ? "Replay" : source.Selected ? "Live" : "Alternate source";
        return $"{frame?.Host ?? source.GuestOf} · {mode}" + (source.Status == null ? "" : $" · {source.Status}");
    }
}
