@using Microsoft.AspNetCore.Components
@using Microsoft.AspNetCore.Components.Web

@foreach (var group in Data.Bands(Depth == 0 ? BandPercent : 0))
{
    @if (group.Start is int start)
    {
        <tr class="resource-band" title="The actual share is the sum of these rows divided by the scope total.">
            <th colspan="@(Data.Paths ? 2 : Data.LabelColumns.Length)" scope="row">
                @start–@(Math.Min(100, start + BandPercent))% start · @ResourceDetailTable.FormatShare(group.Weight / Data.TotalWeight) actual
            </th>
            @if (Data.Paths) { <td colspan="@(Data.LabelColumns.Length - 2)" aria-hidden="true"></td> }
            @for (int column = 0; column < Data.Metrics.Length; column++)
            { <td class="num">@Data.Metrics[column].Display(Data.Metrics[column].Subtotal(group.Rows, column))</td> }
        </tr>
    }
    @foreach (var row in group.Rows)
    {
        var directory = row.Folder;
        var fullPath = !directory.HasValue && Data.Paths && row.Labels[2].Length > 0 ? row.Labels[2] + row.Labels[1] : null;
        <tr data-copy-row="" class="@(directory.HasValue ? "resource-folder-row" : null)" tabindex="@(fullPath == null && !directory.HasValue ? "0" : null)">
            @for (int index = 0; index < row.Labels.Length; index++)
            {
                var label = row.Labels[index];
                <td class="resource-cell" title="@label" style="@(Data.Paths && index == 1 && Depth > 0 ? $"padding-inline-start:{Math.Min(Depth, 15) * 12 + 4}px" : null)">
                    @if (index == 1 && directory is { } folder)
                    {
                        bool open = Expanded.ContainsKey(folder.Id);
                        <button type="button" class="file-path-button folder-expand" aria-expanded="@(open ? "true" : "false")"
                            aria-label="@($"{(open ? "Collapse" : "Expand")} {label}")"
                            @onclick="() => Toggle.InvokeAsync(folder)" @ondblclick="() => Scope.InvokeAsync(folder)">
                            <span aria-hidden="true">@(open ? "▾" : "▸")</span> @label
                        </button>
                        <button type="button" class="resource-icon folder-scope" aria-label="@($"Scope to {label}")"
                            title="Scope to folder" @onclick="() => Scope.InvokeAsync(folder)">⌖</button>
                    }
                    else if (index == 1 && fullPath != null)
                    {
                        <button type="button" class="file-path-button" data-full-path="@fullPath"
                            aria-label="@($"Show full path for {label}")" aria-haspopup="dialog">@label</button>
                    }
                    else { @label }
                </td>
            }
            @for (int column = 0; column < Data.Metrics.Length; column++)
            { <td class="num">@Data.Metrics[column].Display(row.Values[column])</td> }
        </tr>
        @if (directory is { } expanded && Expanded.ContainsKey(expanded.Id) && Branches.TryGetValue(expanded.Id, out var child))
        {
            <ResourceDetailRows Data="child" Depth="@(Depth + 1)" Expanded="Expanded" Branches="Branches" Toggle="Toggle" Scope="Scope" />
        }
    }
}

@code {
    [Parameter, EditorRequired] public ResourceDetailTable Data { get; set; } = default!;
    [Parameter, EditorRequired] public IReadOnlyDictionary<string, DiskPathFolder> Expanded { get; set; } = default!;
    [Parameter, EditorRequired] public IReadOnlyDictionary<string, ResourceDetailTable> Branches { get; set; } = default!;
    [Parameter] public int BandPercent { get; set; }
    [Parameter] public int Depth { get; set; }
    [Parameter] public EventCallback<DiskPathFolder> Toggle { get; set; }
    [Parameter] public EventCallback<DiskPathFolder> Scope { get; set; }
}
