@using Microsoft.AspNetCore.Components
@using Microsoft.AspNetCore.Components.Web
<main>
    <header><h1>Cluster Performance Viewer</h1></header>
    @if (Sources.Length == 0)
    {
        <p>Configure a live collector or replay file in the serverâ€™s Sources setting to see activity.</p>
    }
    <div>
        <ul class="sources" aria-label="Collection status">
            @foreach (var source in Sources)
            {
                <li><strong>@source.Name</strong> <span>@SourceStatus(source)</span></li>
            }
        </ul>
        <div class="toolbar">
            <div class="switch" aria-label="Resource">
                <button aria-pressed="@cpu" @onclick="ShowCpu">CPU</button>
                <button aria-pressed="@(!cpu)" @onclick="() => cpu = false">Disk</button>
            </div>
            @if (cpu || !history.Active)
            {
            <label>Host <select aria-label="Host" @bind="host"><option value="">All hosts</option>
                @foreach (var name in Sources.Select(s => s.Frame?.Host).OfType<string>().Distinct().Order())
                { <option value="@name">@name</option> }
            </select></label>
            }
            @if (!cpu)
            {
                <label>Group by <select aria-label="Group by" @bind="group"><option>Process</option><option>File</option></select></label>
                <label>Sort by <select aria-label="Sort by" @bind="sort"><option>Total</option><option>Read</option><option>Write</option></select></label>
            }
            <label>Show <select aria-label="Show" @bind="limit"><option>20</option><option>50</option><option>100</option></select></label>
            <label>Filter <input type="search" @bind="filter" @bind:event="oninput" /></label>
        </div>
        @if (!cpu) { <HistoryPicker Changed="HistoryChanged" /> }
        @if (!history.Active && Frames.Any(w => w.Guests != null))
        {
            <div class="toolbar" aria-label="Guest expansion">
            @foreach (var w in Frames.Where(w => w.Guests != null))
            {
                var targets = (w.Guests.Cpu?.Sample.Coverage.Select(c => c.Machine) ?? [])
                    .Concat(w.Guests.Disks.Select(d => d.Target)).Distinct().Order();
                @foreach (var target in targets)
                {
                    <label><input type="checkbox" checked="@Selected(w.Host, target)"
                        @onchange="e => SetGuest(w.Host, target, (bool)e.Value!)" /> @w.Host / @target</label>
                }
                @if (cpu && w.Guests.CpuStatus != null) { <span>@w.Host · @w.Guests.CpuStatus</span> }
                @if (!cpu && w.Guests.DiskInventoryStatus != null) { <span>@w.Host · @w.Guests.DiskInventoryStatus</span> }
                @if (!cpu)
                {
                    @foreach (var disk in w.Guests.Disks.Where(d => Selected(w.Host, d.Target) && (d.Files.Length == 0 || d.Status != null)))
                    { <span>@disk.Machine · @(disk.Status ?? "Sampling guest files…")</span> }
                }
                @if (cpu && w.Guests.Cpu is {} sample)
                {
                    @foreach (var coverage in sample.Sample.Coverage.Where(c => Selected(w.Host, c.Machine)))
                    {
                        if (!coverage.SampleAvailable || coverage.HostCores == null)
                        { <span>@coverage.Machine · @(coverage.Failure ?? "CPU attribution unavailable")</span> }
                        else if (coverage.HostCores > coverage.AttributedCores)
                        { <span>@coverage.Machine · @((100 * (coverage.HostCores.Value - coverage.AttributedCores) / sample.Sample.Host.LogicalProcessors).ToString("N2"))% of host CPU unassigned</span> }
                    }
                }
            }
            </div>
        }
        @if (cpu)
        {
            var rows = Frames.SelectMany(w => GuestProjection.CpuRows(w, target => Selected(w.Host, target))
                .Select(row => (w.Host, Row: row))).Where(r => Matches(r.Row.Row.Process))
                .OrderByDescending(r => guestCpuSort ? r.Row.Row.GuestCpuShare : r.Row.HostPercent).Take(limit).ToArray();
            <section><h2>CPU processes</h2><div class="scroll"><table>
                <thead><tr><th>Process</th><th>PID</th><th>Host</th><th>Environment</th><th class="num">Cores</th>
                    <th class="num"><button @onclick="() => guestCpuSort = false">Host CPU</button></th>
                    <th class="num"><button @onclick="() => guestCpuSort = true">Guest CPU share</button></th></tr></thead>
                <tbody>@foreach (var item in rows)
                { var r = item.Row; <tr><td>@r.Row.Process</td><td>@r.Row.Pid</td><td>@item.Host</td><td>@r.Machine</td><td class="num">@r.Row.Cores.ToString("N2")</td><td class="num">@Percent(r.HostPercent)</td><td class="num">@Percent(100 * r.Row.GuestCpuShare)</td></tr> }
                </tbody>
            </table></div>@if (rows.Length == 0) { <p>No matching CPU samples.</p> }</section>
        }
        else
        {
            var rows = DiskRows().ToArray();
            <section><div class="summary"><h2>Disk @(group == "File" ? "paths" : "processes")</h2><span>@Rate(rows.Sum(x => x.Read + x.Write)) MiB/s across matching rows</span></div>
            @if (history.Window is {} stored)
            {
                <p>@stored.Host Â· @stored.Scope Â· @stored.Layer Â· @stored.Start to @stored.End Â· @stored.NamedBytes.ToString("N0") of @stored.CapturedBytes.ToString("N0") bytes named Â· @stored.EventsLost events lost</p>
                @if (stored.Status != "running") { <p role="status">@stored.Status</p> }
            }
            @foreach (var w in Frames.Where(w => !history.Active && w.DiskPaths.Status != null))
            { <p role="status">@w.Host Â· @w.DiskPaths.Status</p> }
            <div class="scroll"><table><thead><tr>
                <th>Process</th><th>PID</th><th>Host</th><th>Environment</th>
                @if (group == "File") { <th>Filename</th><th>Folder</th> }
                <th class="num">Read MiB/s</th><th class="num">Write MiB/s</th><th class="num">Total MiB/s</th><th class="num">Read ops</th><th class="num">Write ops</th>
            </tr></thead><tbody>@foreach (var r in rows.OrderByDescending(r => sort == "Read" ? r.Read : sort == "Write" ? r.Write : r.Read + r.Write).Take(limit))
            { <tr><td>@r.Key.Process</td><td>@r.Key.Pid</td><td>@r.Host</td><td>@r.Machine</td>
                @if (group == "File") { <td>@(r.Key.Path.Length == 0 ? "Unresolved file path" : r.Key.Filename)</td><td class="path">@r.Key.Filepath</td> }
                <td class="num">@Rate(r.Read)</td><td class="num">@Rate(r.Write)</td><td class="num">@Rate(r.Read + r.Write)</td><td class="num">@r.Totals.Reads.ToString("N0")</td><td class="num">@r.Totals.Writes.ToString("N0")</td>
            </tr> }</tbody></table></div>@if (rows.Length == 0) { <p>No matching disk samples.</p> }</section>
        }
    </div>
</main>

@code {
    [Parameter] public SourceWindow[] Sources { get; set; } = [];
    private bool cpu = true, guestCpuSort;
    private HistorySelection history = new(false, null);
    private void ShowCpu() { cpu = true; history = new(false, null); }
    private void HistoryChanged(HistorySelection selection) => history = selection;
    private readonly HashSet<(string Host, string Target)> hiddenGuests = new();
    private bool Selected(string hostName, string target) => !hiddenGuests.Contains((hostName, target));
    private void SetGuest(string hostName, string target, bool enabled)
    {
        if (enabled) hiddenGuests.Remove((hostName, target));
        else hiddenGuests.Add((hostName, target));
    }
    private static string Percent(double? p) => p.HasValue ? p.Value.ToString("N2") + "%" : "—";
    private string host = "", filter = "", group = "Process", sort = "Total";
    private int limit = 20;
    private IEnumerable<PerformanceWindow> Frames => Sources.Where(s => s.Selected && (host.Length == 0 || host == s.Frame!.Host)).Select(s => s.Frame!);
    private bool Matches(string value) => value.Contains(filter, StringComparison.OrdinalIgnoreCase);
    private static string Rate(double value) => (value / 1048576).ToString("N2");
    private static string SourceStatus(SourceWindow s)
    {
        if (s.Frame == null) return s.Status ?? "Waiting";
        string label = s.Stale ? "Stale" : s.Replay ? "Replay" : "Live";
        if (!s.Selected && !s.Stale) label = "Alternate source";
        return $"{s.Frame.Host} Â· {label} Â· {s.Frame.CpuEnd:HH:mm:ss} UTC" + (s.Status != null && !s.Replay ? $" Â· {s.Status}" : "");
    }
    private sealed record DiskRow(string Host, string Machine, FileIoKey Key, FileIoTotals Totals, double Read, double Write);
    private IEnumerable<DiskRow> DiskRows()
    {
        if (history.Active)
        {
            if (history.Window is {} stored)
            {
                var machine = stored.Layer == "physical" ? stored.Host : stored.Scope;
                foreach (var row in GroupRows(stored.Host, stored.DurationSeconds(), stored.Rows.Select(r => r.ToDiskRow(machine))))
                    yield return row;
            }
            yield break;
        }
        foreach (var w in Frames)
            foreach (var row in GroupRows(w.Host, w.DiskPaths.Seconds, GuestProjection.DiskRows(w, target => Selected(w.Host, target))))
                yield return row;
    }

    private IEnumerable<DiskRow> GroupRows(string hostName, double seconds, IEnumerable<DiskIoRow> measured)
    {
        if (seconds <= 0) yield break;
        foreach (var g in measured.GroupBy(r => (r.Machine, File: group == "File" ? r.Key : r.Key.ProcessKey)))
        {
            if (!Matches(g.Key.File.Process) && !Matches(g.Key.File.Path)) continue;
            var t = DiskIoMerge.Sum(g.Select(r => r.Totals));
            yield return new DiskRow(hostName, g.Key.Machine, g.Key.File, t, t.ReadBytes / seconds, t.WriteBytes / seconds);
        }
    }
}
