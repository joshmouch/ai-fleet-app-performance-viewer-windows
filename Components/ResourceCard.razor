@using Microsoft.AspNetCore.Components
@using Microsoft.AspNetCore.Components.Web

<article class="resource-card @(Overview ? "resource-overview" : "")" data-selected="@(Selected ? "true" : "false")"
    data-expanded="@(GraphOpen || DetailsOpen ? "true" : "false")"
    data-branch="@(Children.Length > 0 ? "true" : "false")" data-processor="@(Node.Kind == ResourceKind.Processor ? "true" : "false")"
    style="@Fill" @onclick="Select" @onclick:stopPropagation="true">
    <div class="resource-card-face">
        <div class="resource-card-summary">
            <div class="resource-card-heading">
                @Breadcrumb
                @if (Overview) { <h2 class="resource-name">@Node.Name</h2> }
                else
                {
                    <button type="button" class="resource-name" title="@Node.BackingPath" aria-pressed="@(Selected ? "true" : "false")"
                        @onclick="Select" @onclick:stopPropagation="true">@Node.Name</button>
                }
                @if (Node.Type is not null) { <span class="resource-type">@Node.Type</span> }
                @if (Overview && !PaneOpen)
                {
                    <button type="button" class="resource-icon scope-action" aria-label="Open details pane" title="Open details pane"
                        @onclick="OpenPane" @onclick:stopPropagation="true">≡</button>
                }
            </div>
            @if (Overview || GraphOpen || MetricsVisible && (!Disk || Node.HostShare > 0 || DiskActivity.HasActivity(ChartNode.Reading)))
            {
                <ResourceChart Node="ChartNode" Disk="Disk" Controls="Overview" Graph="GraphOpen" Metrics="MetricsVisible" Stored="Stored"
                    Breakdown="Breakdown"
                    History="@(Overview || GraphOpen ? ReadHistory(Node.Id) : [])" />
            }
        </div>
        @if (!Overview && Selected)
        {
            <div class="resource-card-actions" role="group" aria-label="@($"Actions for {Node.Name}")" @onclick:stopPropagation="true">
                <button type="button" class="resource-icon" aria-label="Graph" title="Graph"
                    aria-pressed="@(GraphOpen ? "true" : "false")" @onclick="() => graph = !graph">∿</button>
                <button type="button" class="resource-icon" aria-label="Metrics" title="Metrics"
                    aria-pressed="@(MetricsVisible ? "true" : "false")" @onclick="() => metrics = !metrics">№</button>
                <button type="button" class="resource-icon" aria-label="Details" title="Details"
                    aria-pressed="@(DetailsOpen ? "true" : "false")" @onclick="() => details = !details">≡</button>
                <button type="button" class="resource-icon" aria-label="Scope to this" title="Scope to this"
                    @onclick="() => Scope.InvokeAsync(Node.Id)">⌖</button>
            </div>
        }
    </div>
    @if (DetailsOpen)
    {
        <ResourceDetails Node="Node" Read="ReadDetails" Disk="Disk" BandPercent="BandPercent" SortChanged="SortChanged" />
    }
    @if (Children.Length > 0)
    {
        <div class="resource-children" @onclick="Clear" @onclick:stopPropagation="true">
            @foreach (var child in Children)
            {
                <ResourceCard @key="child.Node.Id" Node="child.Node" Disk="Disk" SelectedId="@SelectedId" VisibleChildren="VisibleChildren"
                    ReadHistory="ReadHistory" ReadDetails="ReadDetails" BandPercent="BandPercent" Selection="Selection" Scope="Scope"
                    CardReading="child.Reading" SortChanged="SortChanged" />
            }
        </div>
    }
    else if (EmptyCards is string message)
    {
        <div class="resource-chart-compact quiet">@message</div>
    }
    @if (Overview && PaneOpen)
    {
        <div class="resource-dock" @onclick:stopPropagation="true">
            @if (Children.Length > 0)
            {
                <button type="button" class="resource-splitter" data-resource-splitter
                    aria-label="Resize the details pane with the pointer or arrow keys"></button>
            }
            <ResourceDetails Node="Node" Read="ReadDetails" Disk="Disk" BandPercent="BandPercent" Close="ClosePane"
                SortChanged="SortChanged" />
        </div>
    }
</article>

@code {
    [Parameter, EditorRequired] public ResourceNode Node { get; set; } = default!;
    [Parameter, EditorRequired] public Func<ResourceNode, ResourceCardEntry[]> VisibleChildren { get; set; } = default!;
    [Parameter, EditorRequired] public Func<string, IReadOnlyList<ResourcePoint>> ReadHistory { get; set; } = default!;
    [Parameter, EditorRequired] public Func<ResourceNode, bool, ResourceDetailTable> ReadDetails { get; set; } = default!;
    [Parameter] public string? SelectedId { get; set; }
    [Parameter] public EventCallback<string?> Selection { get; set; }
    [Parameter] public EventCallback<string> Scope { get; set; }
    [Parameter] public bool Disk { get; set; }
    [Parameter] public bool Overview { get; set; }
    [Parameter] public bool Stored { get; set; }
    [Parameter] public DiskIoBreakdown? Breakdown { get; set; }
    [Parameter] public bool PaneOpen { get; set; }
    [Parameter] public string? EmptyCards { get; set; }
    [Parameter] public EventCallback OpenPane { get; set; }
    [Parameter] public EventCallback ClosePane { get; set; }
    [Parameter] public RenderFragment? Breadcrumb { get; set; }
    [Parameter] public int BandPercent { get; set; }
    [Parameter] public EventCallback<string> SortChanged { get; set; }
    [Parameter] public ResourceReading? CardReading { get; set; }
    private ResourceCardEntry[] Children = [];
    private bool graph, details, metrics = true;
    protected override void OnParametersSet()
    {
        Children = VisibleChildren(Node);
        if (Selected) return;
        graph = details = false;
        metrics = true;
    }
    private bool Selected => SelectedId == Node.Id;
    private bool GraphOpen => !Overview && Selected && graph;
    private bool DetailsOpen => !Overview && Selected && details;
    private bool MetricsVisible => !Selected || metrics;
    private ResourceNode ChartNode => Disk && !Overview && !GraphOpen && CardReading is { } reading
        ? Node with { Reading = reading } : Node;
    private Task Select() => Selection.InvokeAsync(Overview || Selected ? null : Node.Id);
    private Task Clear() => Selection.InvokeAsync(null);
    // Give small host shares some contrast without scaling each branch to its hottest child.
    private string Fill => FormattableString.Invariant($"--resource-heat:{58 * Math.Sqrt(Math.Clamp(Node.HostShare ?? 0, 0, 1)):0.##}%");
}
